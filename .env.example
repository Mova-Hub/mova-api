APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Live trip tracking ────────────────────────────────────────────────────
#
# Three valid values, and the right one depends on where this is hosted:
#
#   log     — broadcasts go to the log file and nowhere else. The default, and
#             a FULLY WORKING state: the passenger's map falls back to polling
#             /orders/{id}/tracking. Costs latency (~15s), not the feature.
#
#   pusher  — hosted websockets. NOTHING TO RUN, which is what makes it the
#             only realistic option on shared cPanel hosting. Reverb speaks the
#             Pusher protocol, so this is a swap of credentials, not of code.
#
#   reverb  — self-hosted. Needs a PERSISTENT DAEMON (`php artisan reverb:start`
#             under supervisor/systemd) and a wss:// route proxied to
#             REVERB_PORT. cPanel allows neither — it is the same limitation
#             that forces `queue:work --stop-when-empty` onto a cron in
#             routes/console.php instead of a long-running worker. VPS only.
BROADCAST_CONNECTION=log

# ── Option A: hosted Pusher (works on cPanel) ─────────────────────────────
# From the Pusher dashboard, "App Keys". APP_KEY is public and ships in the
# mobile bundle; APP_SECRET signs channel authorisations and must never leave
# the server — anyone holding it can subscribe to any private channel, which
# here means every client's live location. Treat it like the MoMo credentials.
# `eu` is the Frankfurt cluster, the nearest to Brazzaville.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# ── Option B: self-hosted Reverb (VPS only) ───────────────────────────────
# Generate with `php artisan reverb:install`. Same secret rule as above.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
# `https` in production. The mobile client refuses a plaintext socket on iOS
# (ATS) and on Android 9+ (cleartext blocked by default).
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Geolocation for the audit trail (config/location.php)
# ─────────────────────────────────────────────────────────────────────────────
# The activity detail page turns an entry's IP into an APPROXIMATE, network-
# level origin. It works with no token at all — ipinfo.io answers
# unauthenticated requests at a low daily rate — so set this only for quota.
IPINFO_TOKEN=

# To stop sending IPs to a third party entirely, switch config/location.php's
# driver to MaxMind::class and download the local GeoLite2 database instead:
#   MAXMIND_LICENSE_KEY=...        (free account at maxmind.com)
#   php artisan location:update    (re-run monthly)
MAXMIND_LICENSE_KEY=

# Leave FALSE. When true, the package swaps private/loopback IPs for a US
# address — harmless in analytics, but on an audit page it fabricates evidence.
LOCATION_TESTING=false
